---
import type { Dict } from '../../domain/i18n/content';
import type { Locale } from '../../domain/i18n/config';
import { profile } from '../../domain/profile/profile';
import { findExpertiseByKey } from '../../domain/profile/expertise';
import { asset } from '../../shared/lib/asset';

interface Props {
  dict: Dict;
  lang: Locale;
  siteHref: string;
}

const { dict, lang, siteHref } = Astro.props;

// Photos are expected on Brazilian CVs and left out in the US/UK market the EN CV targets.
const showPhoto = lang === 'pt';
const whatsappDigits = profile.social.whatsapp.replace(/\D/g, '');
---

<article class="cv">
  <header class:list={['cv__header', { 'cv__header--photo': showPhoto }]}>
    {showPhoto && (
      <img src={asset(profile.photo)} alt={profile.name} width="80" height="80" class="cv__photo" />
    )}
    <div class="cv__heading">
      <h1 class="cv__name">{profile.name}</h1>
      <p class="cv__role">{dict.meta.jobTitle}</p>
      <ul class="cv__contact" aria-label={dict.cv.contactLabel}>
        <li>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </li>
        <li>
          <a href={`https://wa.me/${whatsappDigits}`} target="_blank" rel="noopener noreferrer">
            {profile.social.whatsapp}
          </a>
        </li>
        <li>
          <a href={profile.social.linkedin} target="_blank" rel="noopener noreferrer">
            linkedin.com/in/johnsonmauro
          </a>
        </li>
        <li>
          <a href={profile.social.github} target="_blank" rel="noopener noreferrer">
            github.com/JohnsonMauro
          </a>
        </li>
        <li>
          <a href={profile.social.medium} target="_blank" rel="noopener noreferrer">
            medium.com/@johnsonmauro
          </a>
        </li>
        <li>
          <a href={siteHref}>{siteHref.replace(/^https?:\/\//, '')}</a>
        </li>
      </ul>
    </div>
  </header>

  <section class="cv__section">
    <h2>{dict.cv.summaryTitle}</h2>
    <p>{dict.about.summary}</p>
    <p>{dict.about.current}</p>
  </section>

  <section class="cv__section">
    <h2>{dict.cv.skillsTitle}</h2>
    <dl class="cv__skills">
      {dict.about.expertise.map((entry) => {
        const category = findExpertiseByKey(entry.key);
        if (!category) return null;
        const names = category.items.flatMap((i) => i.names).join(', ');
        return (
          <div class="cv__skills-row">
            <dt>{entry.label}</dt>
            <dd>{names}</dd>
          </div>
        );
      })}
      <div class="cv__skills-row">
        <dt>{dict.cv.practicesTitle}</dt>
        <dd>{dict.skills.judgment.join(' · ')}</dd>
      </div>
      <div class="cv__skills-row">
        <dt>{dict.cv.languagesTitle}</dt>
        <dd>{dict.languages.map((item) => `${item.name}: ${item.level}`).join(' · ')}</dd>
      </div>
    </dl>
  </section>

  <section class="cv__section cv__section--experience">
    <h2>{dict.cv.experienceTitle}</h2>
    <ol class="cv__experience">
      {dict.resume.map((item) => (
        <li class="cv__job">
          <header class="cv__job-header">
            <h3>
              {item.role}
              <span class="cv__org">
                {' · '}
                {item.url ? (
                  <a href={item.url} target="_blank" rel="noopener noreferrer">
                    {item.org}
                  </a>
                ) : (
                  item.org
                )}
              </span>
            </h3>
            <span class="cv__period">{item.period}</span>
          </header>
          {item.bullets && (
            <ul class="cv__bullets">
              {item.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ol>
  </section>

  <section class="cv__section">
    <h2>{dict.cv.aiTitle}</h2>
    <ul class="cv__practices">
      {dict.skills.aiPractices.map((practice) => (
        <li>
          <strong>{practice.title}.</strong> {practice.proof}
        </li>
      ))}
    </ul>
  </section>

  <section class="cv__section">
    <h2>{dict.cv.educationTitle}</h2>
    <ul class="cv__plain">
      {dict.education.map((item) => (
        <li class="cv__job-header">
          <span>
            <strong>{item.degree}</strong>, {item.school}
          </span>{' '}
          <span class="cv__period">{item.period}</span>
        </li>
      ))}
    </ul>
  </section>
</article>

<style>
  .cv {
    max-width: 820px;
    margin: 0 auto;
    padding: 32px 40px;
    color: var(--palette-print-text);
    background: var(--palette-surface);
    font-family: 'Open Sans', system-ui, sans-serif;
    font-size: 11pt;
    line-height: 1.3;
  }

  .cv__header {
    padding-bottom: 16px;
    border-bottom: 2px solid var(--palette-ink-deep);
  }

  .cv__header--photo {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 20px;
    align-items: center;
  }

  .cv__photo {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--palette-ink-deep);
  }

  .cv__name {
    margin: 0;
    font-family: 'Poppins', system-ui, sans-serif;
    font-size: 22pt;
    font-weight: 700;
    color: var(--palette-ink-deep);
    letter-spacing: -0.02em;
  }

  .cv__role {
    margin: 2px 0 8px;
    font-size: 12pt;
    color: var(--palette-ink-deep);
    font-weight: 600;
  }

  .cv__contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    font-size: 10pt;
  }

  .cv__contact a {
    color: var(--palette-print-text);
    text-decoration: none;
  }

  .cv__contact a:hover {
    color: var(--palette-accent);
    text-decoration: underline;
  }

  .cv__section {
    margin-top: 12px;
  }

  .cv__section h2 {
    margin: 0 0 6px;
    font-family: 'Poppins', system-ui, sans-serif;
    font-size: 11pt;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--palette-ink-deep);
    border-bottom: 1px solid var(--palette-border);
    padding-bottom: 3px;
  }

  .cv__section p {
    margin: 4px 0;
  }

  .cv__skills {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 6px;
  }

  .cv__skills-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 12px;
    align-items: start;
  }

  .cv__skills-row dt {
    font-weight: 600;
    color: var(--palette-ink-deep);
    font-size: 10pt;
  }

  .cv__skills-row dd {
    margin: 0;
    font-size: 10pt;
    color: var(--palette-print-muted);
  }

  .cv__practices {
    margin: 0;
    padding-left: 18px;
    font-size: 10pt;
  }

  .cv__practices li + li {
    margin-top: 1px;
  }

  .cv__practices strong {
    color: var(--palette-ink-deep);
    font-weight: 600;
  }

  .cv__experience {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  /* A job may split between bullets, never inside one or right after its header. */
  .cv__job-header,
  .cv__section h2 {
    break-after: avoid;
  }

  .cv__bullets li {
    break-inside: avoid;
  }

  .cv__job-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .cv__job-header h3 {
    margin: 0;
    font-family: 'Poppins', system-ui, sans-serif;
    font-size: 11.5pt;
    font-weight: 600;
    color: var(--palette-ink-deep);
  }

  .cv__period {
    font-size: 10pt;
    font-weight: 600;
    color: var(--palette-ink-deep);
    white-space: nowrap;
  }

  .cv__org {
    font-family: 'Open Sans', system-ui, sans-serif;
    font-size: 10.5pt;
    font-weight: 400;
    color: var(--palette-print-subtle);
  }

  .cv__org a {
    color: inherit;
    text-decoration: none;
  }

  .cv__org a:hover {
    color: var(--palette-accent);
  }

  .cv__bullets {
    margin: 2px 0 0;
    padding-left: 18px;
    font-size: 10pt;
  }

  .cv__bullets li + li {
    margin-top: 1px;
  }

  .cv__plain {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 10pt;
  }

  @media print {
    @page {
      size: A4;
      margin: 0.5in;
    }

    html,
    body {
      background: var(--palette-surface) !important;
    }

    .cv {
      max-width: none;
      margin: 0;
      padding: 0;
      box-shadow: none;
    }

    .cv__contact a {
      color: var(--palette-print-text) !important;
      text-decoration: none;
    }
  }
</style>
