---
import ResumeColumn from './ResumeColumn.astro';
import type { Dict } from '../../domain/i18n/content';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;

const chapters = dict.career.chapters.map((chapter) => ({
  ...chapter,
  items: dict.resume.filter((entry) => entry.chapter === chapter.key),
}));
---

<section
  id="resume"
  class="section-anchor bg-surface py-20 px-6 xl:pl-[calc(var(--spacing-sidebar)+(--spacing(6)))]"
>
  <div class="mx-auto max-w-page">
    <header class="mb-10">
      <h2 class="font-display text-4xl font-bold text-ink-deep">{dict.sections.experienceTitle}</h2>
      <div class="mt-2 h-1 w-12 rounded-full bg-accent"></div>
    </header>

    <div class="space-y-16">
      {chapters.map((chapter) => (
        <div class="grid gap-8 lg:grid-cols-12">
          <div class="lg:sticky lg:top-8 lg:col-span-4 lg:self-start">
            <p class="text-sm font-semibold text-accent">{chapter.period}</p>
            <h3 class="mt-2 font-display text-2xl font-bold leading-tight text-ink-deep">
              {chapter.title}
            </h3>
            <p class="mt-3 text-ink/80">{chapter.arc}</p>
          </div>
          <div class="lg:col-span-8">
            <ResumeColumn items={chapter.items} />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
