---
import { stackTiers, type StackTierKey, type TechIcon } from '../../domain/profile/expertise';
import { asset } from '../../shared/lib/asset';
import type { Dict } from '../../domain/i18n/content';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;

const ICON_BASE = 'assets/icons/tech';

const tierLabel: Record<StackTierKey, string> = {
  primary: dict.sections.stackPrimaryLabel,
  secondary: dict.sections.stackSecondaryLabel,
  tools: dict.sections.stackToolsLabel,
};

const tierTileClass: Record<'primary' | 'secondary', string> = {
  primary:
    'flex h-16 w-16 items-center justify-center rounded-xl border border-ink/10 bg-surface-card p-3 shadow-sm transition group-hover:-translate-y-0.5 group-hover:border-accent group-hover:shadow-md',
  secondary:
    'flex h-12 w-12 items-center justify-center rounded-lg border border-ink/10 bg-surface-card p-2 shadow-sm transition group-hover:-translate-y-0.5 group-hover:border-accent group-hover:shadow-md',
};

const tierIconClass: Record<StackTierKey, string> = {
  primary: 'h-10 w-10',
  secondary: 'h-7 w-7',
  tools: 'h-4 w-4',
};

const tierCaptionClass: Record<'primary' | 'secondary', string> = {
  primary: 'w-20 text-xs font-medium text-ink/80',
  secondary: 'w-16 text-[0.6875rem] text-ink/60',
};

function iconClasses(item: TechIcon, tierKey: StackTierKey, variant: 'light' | 'dark'): string {
  const base = tierIconClass[tierKey];
  if (variant === 'light') {
    return [
      base,
      item.darkFile ? 'block dark:hidden' : '',
      item.tone === 'mono' ? 'dark:invert' : '',
    ]
      .filter(Boolean)
      .join(' ');
  }
  return `${base} hidden dark:block`;
}

const pad = (n: number) => String(n).padStart(2, '0');
---

<section
  id="skills"
  class="section-anchor bg-surface-alt py-20 px-6 xl:pl-[calc(var(--spacing-sidebar)+(--spacing(6)))]"
>
  <div class="mx-auto max-w-page">
    <header class="mb-12">
      <h2 class="font-display text-4xl font-bold text-ink-deep">{dict.sections.skillsTitle}</h2>
      <div class="mt-2 h-1 w-12 rounded-full bg-accent"></div>
    </header>

    <div>
      <h3 class="font-display text-xl font-bold text-ink-deep">{dict.skills.stackTitle}</h3>

      <div class="mt-8 space-y-10">
        {
          stackTiers.map(({ key, items }) => (
            <div>
              <h4 class="font-display text-sm font-semibold uppercase tracking-wider text-ink/60">
                {tierLabel[key]}
              </h4>
              {key === 'tools' ? (
                <ul class="mt-5 flex flex-wrap gap-2">
                  {items.map((item) => (
                    <li class="inline-flex items-center gap-2 rounded-md border border-ink/10 bg-surface-card px-2.5 py-1.5 text-sm text-ink/80 shadow-sm">
                      {item.file && (
                        <img
                          src={asset(`${ICON_BASE}/${item.file}`)}
                          alt=""
                          width="16"
                          height="16"
                          class={iconClasses(item, key, 'light')}
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                      {item.file && item.darkFile && (
                        <img
                          src={asset(`${ICON_BASE}/${item.darkFile}`)}
                          alt=""
                          width="16"
                          height="16"
                          class={iconClasses(item, key, 'dark')}
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                      <span>{item.names.join(' / ')}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <ul
                  class={`mt-5 flex flex-wrap items-start max-sm:grid max-sm:justify-items-center ${key === 'primary' ? 'gap-4 max-sm:grid-cols-[repeat(auto-fill,minmax(--spacing(20),1fr))]' : 'gap-3 max-sm:grid-cols-[repeat(auto-fill,minmax(--spacing(16),1fr))]'}`}
                >
                  {items.map((item) => (
                    <li class="group flex flex-col items-center gap-2 text-center">
                      <span class={tierTileClass[key]}>
                        {item.file && (
                          <img
                            src={asset(`${ICON_BASE}/${item.file}`)}
                            alt=""
                            width="40"
                            height="40"
                            class={iconClasses(item, key, 'light')}
                            loading="lazy"
                            decoding="async"
                          />
                        )}
                        {item.file && item.darkFile && (
                          <img
                            src={asset(`${ICON_BASE}/${item.darkFile}`)}
                            alt=""
                            width="40"
                            height="40"
                            class={iconClasses(item, key, 'dark')}
                            loading="lazy"
                            decoding="async"
                          />
                        )}
                      </span>
                      <span class={tierCaptionClass[key]}>{item.names.join(' / ')}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-14">
      <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-ink/60">
        {dict.skills.judgmentTitle}
      </h3>
      <ul class="mt-5 flex flex-wrap gap-2">
        {
          dict.skills.judgment.map((item) => (
            <li class="rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-sm font-medium text-accent-dark dark:text-accent-light">
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-14 grid gap-8 border-t border-ink/10 pt-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="text-sm font-semibold text-accent">
          <span aria-hidden="true">→ </span>{dict.skills.aiKicker}
        </p>
        <h3 class="mt-3 font-display text-2xl font-bold leading-tight text-ink-deep lg:text-3xl">
          {dict.skills.aiTitle}
        </h3>
        <p class="mt-4 text-ink/80">{dict.skills.aiIntro}</p>
      </div>

      <ol class="grid gap-4 sm:grid-cols-2 lg:col-span-8">
        {
          dict.skills.aiPractices.map((practice, i) => (
            <li class="rounded-xl border border-ink/10 bg-surface-card p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-accent hover:shadow-md">
              <span class="font-display text-sm font-semibold text-accent" aria-hidden="true">
                {pad(i + 1)}
              </span>
              <h4 class="mt-1 font-display text-lg font-semibold text-ink-deep">
                {practice.title}
              </h4>
              <p class="mt-2 text-sm text-ink/70">{practice.proof}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
