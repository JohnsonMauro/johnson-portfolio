---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { LOCALES, type Locale, isLocale } from '../../domain/i18n/config';
import { getDict } from '../../domain/i18n/content';
import { profile } from '../../domain/profile/profile';
import { asset } from '../../shared/lib/asset';
import { personJsonLd } from '../../domain/seo/jsonld';
import CvDocument from '../../widgets/cv/CvDocument.astro';
import CvToolbar from '../../widgets/cv/CvToolbar.astro';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!isLocale(lang)) {
  throw new Error(`Unsupported locale: ${lang}`);
}

const typedLang = lang as Locale;
const dict = getDict(typedLang);

const siteHref = getAbsoluteLocaleUrl(typedLang, '');
const imageAbsolute = new URL(asset(profile.photo), Astro.site).toString();
const jsonLd = personJsonLd({
  name: profile.name,
  lang: typedLang,
  url: siteHref,
  imageUrl: imageAbsolute,
  jobTitle: dict.meta.jobTitle,
  description: dict.meta.description,
  email: profile.email,
  sameAs: [profile.social.linkedin, profile.social.github, profile.social.medium],
});

const title = `${profile.name} — ${dict.meta.jobTitle} (CV)`;
---

<!DOCTYPE html>
<html lang={typedLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={dict.meta.description} />

    <link rel="icon" type="image/svg+xml" href={asset('assets/img/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Poppins:wght@500;600;700&display=swap"
    />

    <script type="application/ld+json" set:html={jsonLd} is:inline />
  </head>
  <body>
    <CvToolbar dict={dict} lang={typedLang} />

    <main class="cv-page">
      <CvDocument dict={dict} lang={typedLang} siteHref={siteHref} />
    </main>

    <style is:global>
      html,
      body {
        margin: 0;
        padding: 0;
        background: #f3f4f6;
        font-family: 'Open Sans', system-ui, sans-serif;
        color: #1a1a1a;
      }

      .cv-page {
        padding: 24px 16px 48px;
      }

      .cv-page > article {
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        border-radius: 6px;
      }

      @media print {
        .cv-page {
          padding: 0;
        }

        .cv-page > article {
          box-shadow: none;
          border-radius: 0;
        }
      }
    </style>
  </body>
</html>
